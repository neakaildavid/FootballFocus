# Copy to .env (or .env.local for web/) and fill in. Never commit the real
# file — .gitignore already excludes .env*.

# Postgres connection string.
#   Local dev:  postgres://<your-macos-username>@localhost:5432/footballfocus_dev
#   Production: a Neon (https://neon.tech) free-tier pooled connection string
#               (ends in ?sslmode=require). See db/README.md.
DATABASE_URL=

# The Odds API (https://the-odds-api.com) free-tier key. Leave blank until
# you've signed up — the Upcoming Week odds section shows a labeled
# placeholder instead of blocking on it. Limited monthly request credits on
# the free tier: batch all games into one call per refresh, don't poll
# per-game.
ODDS_API_KEY=
